# Database Configuration (Update these values)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=bingo_system
DB_PORT=3306

# Server Configuration
PORT=3000
NODE_ENV=development

# Game Configuration
DRAW_INTERVAL=3
JACKPOT_MIN_LIMIT=1000

# Audio Settings
AUDIO_PATH=./audio
ENABLE_SOUND=true

# ---- Multi-agent / AWS hosting ----
# REQUIRED in production: long random string used to sign agent login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# How long an agent login stays valid (hours)
TOKEN_TTL_HOURS=24
# Set to false once you have created your agent accounts, so nobody else can sign up
ALLOW_AGENT_SIGNUP=true
# Needed only to call POST /api/update-config (global jackpot limit) with header x-admin-key
ADMIN_API_KEY=
# MySQL connections (raise if you run many agents)
DB_CONNECTION_LIMIT=30
# Optional: comma-separated allowed origins if the web app is served from another domain
# CORS_ORIGIN=https://bingo.yourdomain.com

# ---- Player platform ----
# Public address of the site (used inside password-reset e-mails)
PUBLIC_URL=https://bingo.yourdomain.com
# First administrator (created on first start when no admin exists). Remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# E-mail for password resets (npm install nodemailer). Without SMTP the reset link is only printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Bingo <no-reply@yourdomain.com>"
# Business time zone for day/week/month reports, minutes from UTC (Ethiopia = 180)
TZ_OFFSET_MINUTES=180
# Per-IP request limits (a hall full of players shares one address, so these are generous)
RATE_LIMIT_PER_MIN=3000
AUTH_RATE_LIMIT=300
